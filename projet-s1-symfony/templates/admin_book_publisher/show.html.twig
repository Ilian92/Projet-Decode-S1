{% extends 'base.html.twig' %}

{% block title %}BookPublisher{% endblock %}

{% block body %}
    <h1>BookPublisher</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ book_publisher.id }}</td>
            </tr>
            <tr>
                <th>PublisherName</th>
                <td>{{ book_publisher.publisherName }}</td>
            </tr>
            <tr>
                <th>ContactEmail</th>
                <td>{{ book_publisher.contactEmail }}</td>
            </tr>
            <tr>
                <th>Website</th>
                <td>{{ book_publisher.website }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_book_publisher_index') }}">back to list</a>

    <a href="{{ path('app_admin_book_publisher_edit', {'id': book_publisher.id}) }}">edit</a>

    {{ include('admin_book_publisher/_delete_form.html.twig') }}
{% endblock %}

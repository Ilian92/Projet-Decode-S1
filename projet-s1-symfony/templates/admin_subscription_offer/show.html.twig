{% extends 'base.html.twig' %}

{% block title %}SubscriptionOffer{% endblock %}

{% block body %}
    <h1>SubscriptionOffer</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ subscription_offer.id }}</td>
            </tr>
            <tr>
                <th>OfferName</th>
                <td>{{ subscription_offer.offerName }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ subscription_offer.description }}</td>
            </tr>
            <tr>
                <th>MonthlyPrice</th>
                <td>{{ subscription_offer.monthlyPrice }}</td>
            </tr>
            <tr>
                <th>IncludedBooksCount</th>
                <td>{{ subscription_offer.includedBooksCount }}</td>
            </tr>
            <tr>
                <th>CommitmentMonths</th>
                <td>{{ subscription_offer.commitmentMonths }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_subscription_offer_index') }}">back to list</a>

    <a href="{{ path('app_admin_subscription_offer_edit', {'id': subscription_offer.id}) }}">edit</a>

    {{ include('admin_subscription_offer/_delete_form.html.twig') }}
{% endblock %}

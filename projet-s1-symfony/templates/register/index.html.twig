{% extends 'base.html.twig' %}

{% block title %}Inscription - Mississippi.com{% endblock %}

{% block body %}
	{# Register Section with same background style as home page #}
	<section class="pt-8 md:pt-12 pb-16 relative overflow-hidden min-h-[calc(100vh-5rem)] flex items-center">
		{# Layered background: image + gradient (same style as header) #}
		<div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30" style="background-image: url('https://picsum.photos/1200/800');"></div>
		<div class="absolute inset-0 bg-linear-to-br from-white via-contrasted-100/85 to-white"></div>
		{# Decorative elements similar to home page #}
		<div class="absolute inset-0 opacity-5">
			<div class="absolute top-0 left-0 w-96 h-96 bg-primary-300 rounded-full blur-3xl"></div>
			<div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-200 rounded-full blur-3xl"></div>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="max-w-md mx-auto">
				{# Register Card #}
				<div class="bg-white/90 backdrop-blur-sm rounded-lg shadow-xl p-8 md:p-10 border-2 border-primary-200">
					{# Title #}
					<div class="text-center mb-8">
						<h1 class="font-bodoni text-3xl md:text-4xl font-bold text-primary-900 mb-2 relative inline-block">
							<span class="relative z-10">Créer un compte</span>
							<span class="absolute bottom-0 left-0 right-0 h-2 bg-secondary-500/30 z-0 transform -skew-x-12"></span>
						</h1>
						<p class="font-bodoni text-primary-600 mt-4">Rejoignez notre communauté de lecteurs</p>
					</div>

					{# Error message #}
					{% if error %}
						<div class="mb-6 p-4 bg-red-50 border-2 border-red-200 rounded-lg">
							<p class="font-bodoni text-red-800 text-sm">{{ error }}</p>
						</div>
					{% endif %}

					{# Register Form #}
					<form method="post" class="space-y-5">
						{# Last Name field #}
						<div>
							<label for="lastName" class="block font-bodoni text-primary-900 font-medium mb-2">
								Nom <span class="text-red-500">*</span>
							</label>
							<input 
								type="text" 
								id="lastName" 
								name="lastName" 
								value="{{ customer.lastName|default('') }}" 
								class="font-bodoni w-full px-4 py-3 rounded-lg border-2 border-primary-200 focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-900 placeholder:text-primary-400 transition-all duration-200" 
								required
								placeholder="Dupont">
						</div>

						{# First Name field #}
						<div>
							<label for="firstName" class="block font-bodoni text-primary-900 font-medium mb-2">
								Prénom <span class="text-red-500">*</span>
							</label>
							<input 
								type="text" 
								id="firstName" 
								name="firstName" 
								value="{{ customer.firstName|default('') }}" 
								class="font-bodoni w-full px-4 py-3 rounded-lg border-2 border-primary-200 focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-900 placeholder:text-primary-400 transition-all duration-200" 
								required
								placeholder="Jean">
						</div>

						{# Email field #}
						<div>
							<label for="email" class="block font-bodoni text-primary-900 font-medium mb-2">
								Email <span class="text-red-500">*</span>
							</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								value="{{ customer.email|default('') }}"
								class="font-bodoni w-full px-4 py-3 rounded-lg border-2 border-primary-200 focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-900 placeholder:text-primary-400 transition-all duration-200" 
								required
								autocomplete="email"
								placeholder="votre@email.com">
						</div>

					{# Password field #}
					<div>
						<label for="password" class="block font-bodoni text-primary-900 font-medium mb-2">
							Mot de passe <span class="text-red-500">*</span>
						</label>
						<div class="relative">
							<input 
								type="password" 
								id="password" 
								name="password" 
								class="font-bodoni w-full px-4 py-3 pr-12 rounded-lg border-2 border-primary-200 focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-900 placeholder:text-primary-400 transition-all duration-200" 
								required
								autocomplete="new-password"
								placeholder="••••••••">
							<button 
								type="button" 
								id="togglePassword"
								class="absolute right-3 top-1/2 -translate-y-1/2 text-primary-600 hover:text-primary-800 focus:outline-none transition-colors duration-200"
								aria-label="Afficher le mot de passe">
								<svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
								</svg>
								<svg id="eyeSlashIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
								</svg>
							</button>
						</div>
					</div>

						{# Phone field (optional) #}
						<div>
							<label for="phone" class="block font-bodoni text-primary-900 font-medium mb-2">
								Téléphone
							</label>
							<input 
								type="text" 
								id="phone" 
								name="phone" 
								value="{{ customer.phone|default('') }}"
								class="font-bodoni w-full px-4 py-3 rounded-lg border-2 border-primary-200 focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-900 placeholder:text-primary-400 transition-all duration-200" 
								placeholder="06 12 34 56 78">
						</div>

						{# Required fields note #}
						<div class="text-sm">
							<p class="font-bodoni text-primary-600">
								<span class="text-red-500">*</span> Champs obligatoires
							</p>
						</div>

						{# Submit button #}
						<button 
							type="submit" 
							class="w-full bg-secondary-800 hover:bg-secondary-900 text-white font-bodoni font-medium py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-2 border-primary-50 hover:border-secondary-500">
							Créer le compte
						</button>
					</form>

					{# Login link #}
					<div class="mt-6 text-center">
						<p class="font-bodoni text-primary-600 text-sm">
							Déjà un compte ?
							<a href="{{ path('app_login') }}" class="text-primary-800 hover:text-primary-900 font-medium underline">
								Se connecter
							</a>
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const passwordInput = document.getElementById('password');
			const toggleButton = document.getElementById('togglePassword');
			const eyeIcon = document.getElementById('eyeIcon');
			const eyeSlashIcon = document.getElementById('eyeSlashIcon');

			if (toggleButton && passwordInput) {
				toggleButton.addEventListener('click', function() {
					const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
					passwordInput.setAttribute('type', type);

					if (type === 'text') {
						eyeIcon.classList.add('hidden');
						eyeSlashIcon.classList.remove('hidden');
						toggleButton.setAttribute('aria-label', 'Masquer le mot de passe');
					} else {
						eyeIcon.classList.remove('hidden');
						eyeSlashIcon.classList.add('hidden');
						toggleButton.setAttribute('aria-label', 'Afficher le mot de passe');
					}
				});
			}
		});
	</script>
{% endblock %}

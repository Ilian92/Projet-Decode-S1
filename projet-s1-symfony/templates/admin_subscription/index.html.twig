{% extends 'base.html.twig' %}

{% block title %}Subscription index{% endblock %}

{% block body %}
    <h1>Subscription index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>StartDate</th>
                <th>ExpectedEndDate</th>
                <th>Status</th>
                <th>NextPaymentDate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for subscription in subscriptions %}
            <tr>
                <td>{{ subscription.id }}</td>
                <td>{{ subscription.startDate ? subscription.startDate|date('Y-m-d') : '' }}</td>
                <td>{{ subscription.expectedEndDate ? subscription.expectedEndDate|date('Y-m-d') : '' }}</td>
                <td>{{ subscription.status }}</td>
                <td>{{ subscription.nextPaymentDate ? subscription.nextPaymentDate|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_admin_subscription_show', {'id': subscription.id}) }}">show</a>
                    <a href="{{ path('app_admin_subscription_edit', {'id': subscription.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_subscription_new') }}">Create new</a>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Subscription{% endblock %}

{% block body %}
    <h1>Subscription</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ subscription.id }}</td>
            </tr>
            <tr>
                <th>StartDate</th>
                <td>{{ subscription.startDate ? subscription.startDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>ExpectedEndDate</th>
                <td>{{ subscription.expectedEndDate ? subscription.expectedEndDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ subscription.status }}</td>
            </tr>
            <tr>
                <th>NextPaymentDate</th>
                <td>{{ subscription.nextPaymentDate ? subscription.nextPaymentDate|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_subscription_index') }}">back to list</a>

    <a href="{{ path('app_admin_subscription_edit', {'id': subscription.id}) }}">edit</a>

    {{ include('admin_subscription/_delete_form.html.twig') }}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Chat avec l'Assistant Database{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 flex flex-col">
    {# Header #}
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Assistant Database</h1>
                        <p class="text-sm text-gray-500 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-green-500"></span>
                            En ligne
                        </p>
                    </div>
                </div>
                <a href="{{ path('app_home') }}" class="px-4 py-2 text-gray-700 hover:text-gray-900 transition-colors">
                    ← Retour à l'accueil
                </a>
            </div>
        </div>
    </header>

    {# Zone de chat #}
    <div class="flex-1 flex flex-col max-w-5xl w-full mx-auto p-4" data-controller="chatbot">
        {# Messages #}
        <div class="flex-1 bg-white rounded-lg shadow-lg mb-4 overflow-hidden flex flex-col">
            <div class="flex-1 overflow-y-auto p-6 space-y-4" data-chatbot-target="messages">
                {# Message de bienvenue #}
                <div class="flex flex-col max-w-[80%] self-start">
                    <div class="py-3 px-4 rounded-2xl text-sm leading-6 bg-white text-gray-800 border border-gray-200 shadow-sm rounded-bl-sm">
                        Bonjour ! 👋 Je suis votre assistant Database. Je peux vous aider à explorer et interroger la base de données. Comment puis-je vous aider aujourd'hui ?
                    </div>
                    <div class="text-xs text-gray-400 mt-1.5 px-2">
                        {{ "now"|date("H:i") }}
                    </div>
                </div>
            </div>

            {# Zone de saisie #}
            <div class="border-t border-gray-200 p-4 bg-gray-50">
                <form class="flex gap-3" data-action="submit->chatbot#sendMessage">
                    <input 
                        type="text" 
                        class="flex-1 py-3 px-4 border border-gray-300 rounded-full text-sm outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" 
                        placeholder="Tapez votre message..."
                        data-chatbot-target="input"
                        data-action="keydown->chatbot#handleKeydown"
                        autocomplete="off"
                    >
                    <button type="submit" 
                            class="px-6 py-3 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 border-0 text-white font-medium cursor-pointer flex items-center justify-center gap-2 transition-all hover:scale-105 hover:shadow-lg disabled:opacity-60 disabled:cursor-not-allowed" 
                            data-chatbot-target="button">
                        <span>Envoyer</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        {# Suggestions #}
        <div class="bg-white rounded-lg shadow p-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-3">💡 Suggestions de questions :</h3>
            <div class="flex flex-wrap gap-2">
                <button class="px-3 py-1.5 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition-colors">
                    Liste des œuvres
                </button>
                <button class="px-3 py-1.5 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition-colors">
                    Auteurs disponibles
                </button>
                <button class="px-3 py-1.5 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition-colors">
                    Rechercher une œuvre
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Chat avec l'Assistant Database - Mississippi.com{% endblock %}

{% block body %}
<section class="min-h-screen pt-8 md:pt-12 pb-16 relative overflow-hidden">
    {# Layered background: image + gradient (same style as home) #}
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30" style="background-image: url('https://picsum.photos/1200/800');"></div>
    <div class="absolute inset-0 bg-linear-to-br from-white via-contrasted-100/85 to-white"></div>
    {# Decorative elements #}
    <div class="absolute inset-0 opacity-5">
        <div class="absolute top-0 left-0 w-96 h-96 bg-primary-300 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-200 rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
        {# Breadcrumb (Amazon-style) #}
        <nav class="font-bodoni text-sm text-primary-600 mb-6" aria-label="Fil d'Ariane">
            <ol class="flex flex-wrap items-center gap-1">
                <li><a href="{{ path('app_home') }}" class="hover:text-secondary-800 underline">Accueil</a></li>
                <li aria-hidden="true">></li>
                <li><span class="text-primary-900 font-medium">Assistant Database</span></li>
            </ol>
        </nav>

        {# Header #}
        <div class="text-center mb-8">
            <h1 class="font-bodoni text-2xl md:text-3xl font-bold text-primary-900 mb-2 relative inline-block">
                <span class="relative z-10">Assistant Database</span>
                <span class="absolute bottom-0 left-0 right-0 h-2 bg-secondary-500/30 z-0 transform -skew-x-12"></span>
            </h1>
            <p class="font-bodoni text-sm text-primary-600 flex items-center justify-center gap-2 mt-2">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                En ligne
            </p>
        </div>

        {# Zone de chat #}
        <div class="flex-1 flex flex-col max-w-5xl w-full mx-auto" data-controller="chatbot">
            {# Messages #}
            <div class="flex-1 bg-primary-50 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 mb-6 overflow-hidden flex flex-col" style="min-height: 500px;">
                <div class="flex-1 overflow-y-auto p-6 space-y-4 flex flex-col" data-chatbot-target="messages">
                    {# Message de bienvenue #}
                    <div class="flex flex-col w-full items-start">
                        <div class="py-3 px-4 rounded-2xl text-sm leading-6 bg-white text-primary-800 border-2 border-primary-200 shadow-sm rounded-bl-sm max-w-[80%]">
                            Bonjour ! Je suis votre assistant Database. Je peux vous aider à explorer et interroger la base de données. Comment puis-je vous aider aujourd'hui ?
                        </div>
                        <div class="font-bodoni text-xs text-primary-600 mt-1.5 px-2">
                            {{ "now"|date("H:i") }}
                        </div>
                    </div>
                </div>

                {# Zone de saisie #}
                <div class="border-t-2 border-primary-200 p-4 bg-white">
                    <form class="flex gap-3" data-action="submit->chatbot#sendMessage">
                        <input
                            type="text"
                            class="font-bodoni flex-1 py-3 px-4 border-2 border-primary-300 rounded-full text-sm outline-none transition-all focus:border-primary-500 focus:ring-2 focus:ring-primary-300"
                            placeholder="Tapez votre message..."
                            data-chatbot-target="input"
                            data-action="keydown->chatbot#handleKeydown"
                            autocomplete="off"
                        >
                        <button type="submit"
                                class="font-bodoni px-6 py-3 rounded-full bg-secondary-800 hover:bg-secondary-900 border-0 text-white font-medium cursor-pointer flex items-center justify-center gap-2 transition-all hover:shadow-lg disabled:opacity-60 disabled:cursor-not-allowed"
                                data-chatbot-target="button">
                            <span>Envoyer</span>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>

            {# Suggestions #}
            <div class="bg-primary-100 rounded-lg shadow-sm p-6">
                <h3 class="font-bodoni text-base font-semibold text-primary-900 mb-4">💡 Suggestions de questions :</h3>
                <div class="flex flex-wrap gap-2">
                    <button class="font-bodoni px-4 py-2 text-sm bg-white hover:bg-primary-50 text-primary-700 border-2 border-primary-200 hover:border-primary-300 rounded-full transition-all duration-300">
                        Liste des œuvres
                    </button>
                    <button class="font-bodoni px-4 py-2 text-sm bg-white hover:bg-primary-50 text-primary-700 border-2 border-primary-200 hover:border-primary-300 rounded-full transition-all duration-300">
                        Auteurs disponibles
                    </button>
                    <button class="font-bodoni px-4 py-2 text-sm bg-white hover:bg-primary-50 text-primary-700 border-2 border-primary-200 hover:border-primary-300 rounded-full transition-all duration-300">
                        Rechercher une œuvre
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

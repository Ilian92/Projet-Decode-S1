{% extends 'base.html.twig' %}

{% block title %}Détail de la commande #{{ order.id }}
	- Mississippi.com
{% endblock %}

{% block body %}
	<section class="py-8 md:py-12 bg-linear-to-br from-primary-50 via-white to-primary-50">
		<div class="container mx-auto px-4">
			<div class="mb-6">
				<a href="{{ path('app_profile') }}" class="inline-flex items-center text-sm font-bodoni text-primary-700 hover:text-primary-900 transition-colors">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
					</svg>
					Retour à mon profil
				</a>
			</div>

			<div class="text-center mb-8">
				<h1 class="font-bodoni text-3xl md:text-4xl font-bold text-primary-900 mb-2 relative inline-block">
					<span class="relative z-10">Commande #{{ order.id }}</span>
					<span class="absolute bottom-0 left-0 right-0 h-2 bg-secondary-500/30 z-0 transform -skew-x-12"></span>
				</h1>
				<p class="font-bodoni text-primary-700 mt-2">
					Passée le
					{{ order.orderDate|date('d/m/Y à H:i') }}
				</p>
			</div>

			<div class="grid gap-6 lg:grid-cols-3 max-w-6xl mx-auto">
				<div class="lg:col-span-2 space-y-6">
					<div class="bg-white rounded-xl shadow-lg border border-primary-100 overflow-hidden">
						<div class="bg-primary-900 px-6 py-4 border-b-4 border-secondary-500 flex items-center justify-between">
							<h2 class="font-bodoni text-xl font-bold text-white flex items-center gap-3">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/>
								</svg>
								Détail des articles
							</h2>
							<span class="inline-block px-3 py-1 text-xs font-bold rounded {{ order.status|order_status_badge_class }}">
								{{ order.status|order_status_label }}
							</span>
						</div>

						<div class="p-6">
							{% if order.orderLine|length == 0 %}
								<p class="text-primary-700 font-bodoni">Cette commande ne contient aucun article.</p>
							{% else %}
								<div class="divide-y divide-primary-100">
									{% for line in order.orderLine %}
										{% set book = line.book %}
										{% set work = book ? book.work : null %}
										<a href="{{ path('app_work_show', { id: work.id }) }}" class="py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
											<div>
												<p class="font-bodoni font-semibold text-primary-900 text-lg">
													{{ work ? work.title : 'Livre inconnu' }}
												</p>
												{% if book %}
													<p class="text-sm text-primary-600">
														Édition
														{{ book.id }}
													</p>
												{% endif %}
											</div>
											<div class="flex items-center gap-8 md:text-right">
												<div>
													<p class="text-xs uppercase tracking-wide text-primary-500 font-semibold">Quantité</p>
													<p class="font-bodoni text-primary-900 text-lg">{{ line.quantity }}</p>
												</div>
												<div>
													<p class="text-xs uppercase tracking-wide text-primary-500 font-semibold">Prix unitaire</p>
													<p class="font-bodoni text-primary-900 text-lg">
														{{ (line.unitPriceSnapshot / 100)|number_format(2, ',', ' ') }}
														€
													</p>
												</div>
												<div>
													<p class="text-xs uppercase tracking-wide text-primary-500 font-semibold">Total</p>
													<p class="font-bodoni text-primary-900 text-lg font-bold">
														{{ ((line.unitPriceSnapshot * line.quantity) / 100)|number_format(2, ',', ' ') }}
														€
													</p>
												</div>
											</div>
										</a>
									{% endfor %}
								</div>
							{% endif %}
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div class="bg-white rounded-xl shadow-lg border border-primary-100 overflow-hidden">
						<div class="bg-primary-900 px-6 py-4 border-b-4 border-secondary-500">
							<h2 class="font-bodoni text-xl font-bold text-white flex items-center gap-3">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l9-4 9 4-9 4-9-4zM3 17l9 4 9-4M3 12l9 4 9-4"/>
								</svg>
								Récapitulatif
							</h2>
						</div>
						<div class="p-6 space-y-3">
							<div class="flex justify-between text-primary-700">
								<span class="font-bodoni">Sous-total articles</span>
								{% set subtotal = (order.totalAmount - order.shippingCost) / 100 %}
								<span class="font-bodoni font-semibold">
									{{ subtotal|number_format(2, ',', ' ') }}
									€
								</span>
							</div>
							<div class="flex justify-between text-primary-700">
								<span class="font-bodoni">Livraison</span>
								<span class="font-bodoni font-semibold">
									{{ (order.shippingCost / 100)|number_format(2, ',', ' ') }}
									€
								</span>
							</div>
							<div class="border-t border-primary-100 pt-3 mt-2 flex justify-between items-center">
								<span class="font-bodoni font-bold text-primary-900 text-lg">Total payé</span>
								<span class="font-bodoni font-bold text-primary-900 text-xl">
									{{ (order.totalAmount / 100)|number_format(2, ',', ' ') }}
									€
								</span>
							</div>
							{% if order.stripePaymentIntentId and order.status != 'refunded' %}
								<div class="mt-4 pt-4 border-t border-primary-100">
									{% include 'components/refund_modal.html.twig' with {
										modal_id: 'order-refund-modal-' ~ order.id,
										form_id: 'order-refund-form-' ~ order.id,
										action: path('app_order_refund', { id: order.id }),
										csrf_token: csrf_token('order_refund' ~ order.id),
										button_label: 'Demander un remboursement',
										button_classes: 'w-full inline-flex items-center justify-center gap-2 bg-primary-100 text-primary-800 rounded-lg px-4 py-3 font-bodoni font-semibold hover:bg-primary-200 transition-colors',
										title: 'Demander un remboursement',
										description: 'Êtes-vous sûr de vouloir demander le remboursement de cette commande ? Le montant sera recrédité sur votre moyen de paiement sous quelques jours.',
										confirm_label: 'Oui, demander le remboursement',
										confirm_classes: 'flex-1 px-4 py-3 rounded-lg font-bodoni font-semibold bg-secondary-800 text-white hover:bg-secondary-900 transition-colors'
									} %}
								</div>
							{% endif %}
						</div>
					</div>

					<div class="bg-white rounded-xl shadow-lg border border-primary-100 overflow-hidden">
						<div class="bg-primary-900 px-6 py-4 border-b-4 border-secondary-500">
							<h2 class="font-bodoni text-xl font-bold text-white flex items-center gap-3">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
								</svg>
								Livraison
							</h2>
						</div>
						<div class="p-6 space-y-3">
							{% if order.address %}
								<p class="font-bodoni font-semibold text-primary-900">
									{{ customer.firstName }}
									{{ customer.lastName }}
								</p>
								<p class="font-bodoni text-primary-900">
									{{ order.address.street }}
								</p>
								{% if order.address.addressDetails %}
									<p class="font-bodoni text-primary-700">
										{{ order.address.addressDetails }}
									</p>
								{% endif %}
								<p class="font-bodoni text-primary-900">
									{{ order.address.postalCode }}
									{{ order.address.city }}
								</p>
								<p class="font-bodoni text-primary-700">
									{{ order.address.country }}
								</p>
							{% else %}
								<p class="font-bodoni text-primary-700">
									Aucune adresse de livraison associée à cette commande.
								</p>
							{% endif %}

							{% if order.trackingNumber %}
								<div class="pt-3 border-t border-primary-100 mt-3">
									<p class="text-xs uppercase tracking-wide text-primary-500 font-semibold mb-1">
										Numéro de suivi
									</p>
									<p class="font-bodoni font-semibold text-primary-900">
										{{ order.trackingNumber }}
									</p>
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

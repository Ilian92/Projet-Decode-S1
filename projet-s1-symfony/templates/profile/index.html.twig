{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Mississippi.com{% endblock %}

{% block body %}
	<section class="py-8 md:py-12 bg-linear-to-br from-primary-50 via-white to-primary-50">
		<div class="container mx-auto px-4">
			<div class="text-center mb-8">
				<h1 class="font-bodoni text-3xl md:text-4xl font-bold text-primary-900 mb-2 relative inline-block">
					<span class="relative z-10">Mon Profil</span>
					<span class="absolute bottom-0 left-0 right-0 h-2 bg-secondary-500/30 z-0 transform -skew-x-12"></span>
				</h1>
				<p class="font-bodoni text-primary-700 mt-4 text-lg">Bienvenue {{ customer.firstName }} {{ customer.lastName }}</p>
			</div>

			<div class="max-w-3xl mx-auto">
				<div class="bg-white rounded-xl shadow-lg border border-primary-100 overflow-hidden">
					<div class="bg-primary-900 px-6 py-4 border-b-4 border-secondary-500">
						<h2 class="font-bodoni text-xl font-bold text-white flex items-center gap-3">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
							Mes informations
						</h2>
					</div>

					<div class="p-8 space-y-4">
						<div class="flex items-center border-b border-primary-100 pb-3">
							<label class="text-sm font-semibold text-primary-600 w-1/3">Prénom</label>
							<p class="font-bodoni text-lg text-primary-900 font-semibold flex-1">{{ customer.firstName }}</p>
						</div>

						<div class="flex items-center border-b border-primary-100 pb-3">
							<label class="text-sm font-semibold text-primary-600 w-1/3">Nom</label>
							<p class="font-bodoni text-lg text-primary-900 font-semibold flex-1">{{ customer.lastName }}</p>
						</div>

						<div class="flex items-center border-b border-primary-100 pb-3">
							<label class="text-sm font-semibold text-primary-600 w-1/3">Email</label>
							<p class="font-bodoni text-lg text-primary-900 flex-1 break-all">{{ customer.email }}</p>
						</div>

						<div class="flex items-center border-b border-primary-100 pb-3">
							<label class="text-sm font-semibold text-primary-600 w-1/3">Téléphone</label>
							<p class="font-bodoni text-lg text-primary-900 flex-1">{{ customer.phone }}</p>
						</div>

						<div class="flex items-center border-b border-primary-100 pb-3">
							<label class="text-sm font-semibold text-primary-600 w-1/3">Membre depuis</label>
							<p class="font-bodoni text-lg text-primary-900 flex-1">{{ customer.registrationDate|date('d/m/Y') }}</p>
						</div>

						{% if customer.lastLogin %}
							<div class="flex items-center border-b border-primary-100 pb-3">
								<label class="text-sm font-semibold text-primary-600 w-1/3">Dernière connexion</label>
								<p class="font-bodoni text-lg text-primary-900 flex-1">{{ customer.lastLogin|date('d/m/Y à H:i') }}</p>
							</div>
						{% endif %}

						{% if customer.address %}
							<div class="flex items-start border-b border-primary-100 pb-3 pt-2">
								<label class="text-sm font-semibold text-primary-600 w-1/3">Adresse</label>
								<div class="flex-1">
									<p class="font-bodoni text-lg text-primary-900">{{ customer.address.street }}</p>
									{% if customer.address.addressDetails %}
										<p class="font-bodoni text-primary-700">{{ customer.address.addressDetails }}</p>
									{% endif %}
									<p class="font-bodoni text-lg text-primary-900 mt-1">{{ customer.address.postalCode }} {{ customer.address.city }}</p>
									<p class="font-bodoni text-primary-700">{{ customer.address.country }}</p>
								</div>
							</div>
						{% endif %}

						<div class="flex items-center border-b border-primary-100 pb-3">
							<label class="text-sm font-semibold text-primary-600 w-1/3">Nombre de commandes</label>
							<p class="font-bodoni text-lg text-primary-900 font-bold flex-1">{{ customer.orders|length }}</p>
						</div>

						{% if customer.orders|length > 0 %}
							<div class="pt-4">
								<h3 class="text-sm font-semibold text-primary-600 mb-3 uppercase tracking-wide">Commandes récentes</h3>
								<div class="space-y-3">
									{% for order in customer.orders|slice(0, 5) %}
										<div class="flex items-center justify-between p-4 bg-primary-50 rounded-lg border border-primary-100">
											<div>
												<p class="font-bodoni font-bold text-primary-900">Commande #{{ order.id }}</p>
												<p class="text-sm text-primary-600">{{ order.orderDate|date('d/m/Y') }}</p>
											</div>
											<div class="text-right">
												<p class="font-bodoni font-bold text-primary-900 text-lg">{{ order.totalAmount|number_format(2, ',', ' ') }} €</p>
												<span class="inline-block px-2 py-1 text-xs font-bold rounded
													{% if order.status == 'pending' %}bg-yellow-200 text-yellow-900
													{% elseif order.status == 'shipped' %}bg-blue-200 text-blue-900
													{% elseif order.status == 'delivered' %}bg-green-200 text-green-900
													{% else %}bg-gray-200 text-gray-900{% endif %}">
													{{ order.status|upper }}
												</span>
											</div>
										</div>
									{% endfor %}
								</div>
							</div>
						{% endif %}

						{% if customer.subscriptions|length > 0 %}
							<div class="pt-4 border-t border-primary-100">
								<h3 class="text-sm font-semibold text-primary-600 mb-3 uppercase tracking-wide">Mes abonnements ({{ customer.subscriptions|length }})</h3>
								<div class="space-y-3">
									{% for subscription in customer.subscriptions %}
										<div class="p-4 bg-secondary-50 rounded-lg border border-secondary-100">
											<p class="font-bodoni font-bold text-primary-900 text-lg mb-2">{{ subscription.subscriptionOffer.name }}</p>
											<p class="text-sm text-primary-600">Depuis le {{ subscription.startDate|date('d/m/Y') }}</p>
											{% if subscription.endDate %}
												<p class="text-sm text-primary-600">Jusqu'au {{ subscription.endDate|date('d/m/Y') }}</p>
											{% endif %}
											<span class="inline-block mt-2 px-3 py-1 text-xs font-bold rounded
												{% if subscription.status == 'active' %}bg-green-200 text-green-900
												{% else %}bg-gray-200 text-gray-900{% endif %}">
												{{ subscription.status|upper }}
											</span>
										</div>
									{% endfor %}
								</div>
							</div>
						{% endif %}

						<div class="pt-6 space-y-3 border-t border-primary-100 mt-6">
							<a href="{{ path('app_logout') }}" class="w-full bg-secondary-800 hover:bg-secondary-900 text-white font-bodoni font-semibold py-3 px-4 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 flex items-center justify-center gap-2">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
								</svg>
								Déconnexion
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

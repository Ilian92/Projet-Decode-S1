{% extends 'base.html.twig' %}

{% block title %}Mississippi.com - Votre librairie en ligne
{% endblock %}

{% block body %}
{# Featured Books Carousel - Best sellers #}
<section class="bg-gradient-to-br from-primary-100 via-primary-50 to-primary-200 py-16">
	<div class="container mx-auto px-4 ">
		{% include 'components/section_header.html.twig' with {
            title: 'Meilleures ventes',
            showViewAll: true
        } %}

		<div class="flex flex-wrap gap-6 justify-center">
			{% for i in 1..8 %}
				{% include 'components/book_card.html.twig' with {
                    title: 'Le Nom du Vent',
                    author: 'Patrick Rothfuss',
                    price: '24,90',
                    imageUrl: 'https://picsum.photos/300/400?random=' ~ i,
                    badge: 'Bestseller',
                    rating: 4.8
                } %}
			{% endfor %}
		</div>
	</div>
</section>

{# New Releases Section - Latest books #}
<section class="bg-white py-16">
	<div class="container mx-auto px-4">
		{% include 'components/section_header.html.twig' with {
            title: 'Dernières parutions',
            subtitle: 'Découvrez les nouveautés de ce mois',
            showViewAll: true
        } %}

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{% for i in 1..3 %}
				{% include 'components/new_release_card.html.twig' with {
                    title: 'L\'Art de la Guerre',
                    author: 'Sun Tzu',
                    description: 'Un classique intemporel de stratégie militaire qui continue d\'inspirer les leaders modernes dans tous les domaines.',
                    price: '19,90',
                    imageUrl: 'https://picsum.photos/400/600?random=' ~ (i + 10),
                    releaseDate: 'Janvier 2026'
                } %}
			{% endfor %}
		</div>
	</div>
</section>

{# Monthly Box / Subscription Highlight #}
{% include 'components/subscription_box.html.twig' %}

{# Editor's Picks - Curated selections #}
<section class="bg-primary-100 py-16">
	<div class="container mx-auto px-4">
		{% include 'components/section_header.html.twig' with {
            title: 'Nos coups de cœur',
            subtitle: 'Des livres qui nous ont marqués, sélectionnés avec soin par notre équipe de passionnés',
            centered: true,
            badge: 'Sélection des libraires',
            showViewAll: false
        } %}

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
			{% for i in 1..4 %}
				{% include 'components/book_card.html.twig' with {
                    title: 'Les Misérables',
                    author: 'Victor Hugo',
                    price: '22,90',
                    imageUrl: 'https://picsum.photos/400/600?random=' ~ (i + 20),
                    showRating: false,
                    showHeartIcon: true,
                    hoverQuote: 'Un chef-d\'œuvre qui vous transporte dans un univers captivant...',
                    buttonText: 'Voir',
                    buttonClass: 'bg-primary-500 hover:bg-primary-600'
                } %}
            {% endfor %}
        </div>
    </div>
</section>

{# Newsletter Signup Section #}
{% include 'components/newsletter_signup.html.twig' %}
{% endblock %}

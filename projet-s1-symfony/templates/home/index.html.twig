{% extends 'base.html.twig' %}

{% block title %}Mississippi.com - Votre librairie en ligne
{% endblock %}

{% block body %}
	{# SVG ClipPath Definition for Wave Pattern #}
	<svg class="absolute w-0 h-0">
		<defs>
			<clipPath id="waveClip" clippathunits="objectBoundingBox">
				<path d="M0,0 L1,0 L1,0.9 C0.9875,0.882 0.9875,0.918 0.975,0.9 C0.9625,0.882 0.9625,0.918 0.95,0.9 C0.9375,0.882 0.9375,0.918 0.925,0.9 C0.9125,0.882 0.9125,0.918 0.9,0.9 C0.8875,0.882 0.8875,0.918 0.875,0.9 C0.8625,0.882 0.8625,0.918 0.85,0.9 C0.8375,0.882 0.8375,0.918 0.825,0.9 C0.8125,0.882 0.8125,0.918 0.8,0.9 C0.7875,0.882 0.7875,0.918 0.775,0.9 C0.7625,0.882 0.7625,0.918 0.75,0.9 C0.7375,0.882 0.7375,0.918 0.725,0.9 C0.7125,0.882 0.7125,0.918 0.7,0.9 C0.6875,0.882 0.6875,0.918 0.675,0.9 C0.6625,0.882 0.6625,0.918 0.65,0.9 C0.6375,0.882 0.6375,0.918 0.625,0.9 C0.6125,0.882 0.6125,0.918 0.6,0.9 C0.5875,0.882 0.5875,0.918 0.575,0.9 C0.5625,0.882 0.5625,0.918 0.55,0.9 C0.5375,0.882 0.5375,0.918 0.525,0.9 C0.5125,0.882 0.5125,0.918 0.5,0.9 C0.4875,0.882 0.4875,0.918 0.475,0.9 C0.4625,0.882 0.4625,0.918 0.45,0.9 C0.4375,0.882 0.4375,0.918 0.425,0.9 C0.4125,0.882 0.4125,0.918 0.4,0.9 C0.3875,0.882 0.3875,0.918 0.375,0.9 C0.3625,0.882 0.3625,0.918 0.35,0.9 C0.3375,0.882 0.3375,0.918 0.325,0.9 C0.3125,0.882 0.3125,0.918 0.3,0.9 C0.2875,0.882 0.2875,0.918 0.275,0.9 C0.2625,0.882 0.2625,0.918 0.25,0.9 C0.2375,0.882 0.2375,0.918 0.225,0.9 C0.2125,0.882 0.2125,0.918 0.2,0.9 C0.1875,0.882 0.1875,0.918 0.175,0.9 C0.1625,0.882 0.1625,0.918 0.15,0.9 C0.1375,0.882 0.1375,0.918 0.125,0.9 C0.1125,0.882 0.1125,0.918 0.1,0.9 C0.0875,0.882 0.0875,0.918 0.075,0.9 C0.0625,0.882 0.0625,0.918 0.05,0.9 C0.0375,0.882 0.0375,0.918 0.025,0.9 C0.0125,0.882 0.0125,0.918 0,0.9 L0,1 Z"></path>
			</clipPath>
		</defs>
	</svg>

	{# Hero Section - Service Description #}
	<section
		class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden -mb-24 z-1" style="clip-path: url(#waveClip);">
		{# Background Image Layer #}
		<div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1920&q=80');"></div>

		{# Overlay Gradient #}
		<div class="absolute inset-0 bg-gradient-to-br from-primary-900/90 via-primary-800/85 to-primary-700/90"></div>

		{# Decorative Elements #}
		<div class="absolute inset-0 opacity-10">
			<div class="absolute top-20 left-10 w-72 h-72 bg-secondary-800 rounded-full blur-3xl"></div>
			<div class="absolute bottom-20 right-10 w-96 h-96 bg-contrasted-400 rounded-full blur-3xl"></div>
		</div>

		{# Content Container #}
		<div class="container mx-auto px-4 relative z-10 -mt-20">
			<div class="max-w-4xl mx-auto">
				<div
					class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
					{# Text Content #}
					<div class="text-center md:text-left space-y-6">
						<h1 class="font-bodoni text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight">
							Votre librairie en ligne
						</h1>
						<p class="font-bodoni text-lg md:text-xl text-primary-100 leading-relaxed">
							Découvrez un univers de livres neufs et d'occasion, des ebooks et des sélections curatées par notre équipe de passionnés. Mississippi.com vous accompagne dans toutes vos lectures.
						</p>
						<div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start pt-4">
							<a href="{{ path('app_search') }}" class="inline-flex items-center justify-center gap-2 bg-secondary-800 hover:bg-secondary-900 text-white font-bodoni font-medium px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
								</svg>
								Explorer notre catalogue
							</a>
						</div>
					</div>

					{# Image Gallery #}
					<div class="hidden md:grid grid-cols-2 gap-3 relative max-w-xs mx-auto">
						<div class="space-y-4">
							<div class="aspect-[3/4] rounded-lg overflow-hidden shadow-2xl transform rotate-3 hover:rotate-0 transition-transform duration-300">
								<img
									src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&q=80"
									alt="Livres classiques"
									width="400"
									height="533"
									fetchpriority="high"
									class="w-full h-full object-cover"
								>
							</div>
							<div class="aspect-[3/4] rounded-lg overflow-hidden shadow-2xl transform -rotate-2 hover:rotate-0 transition-transform duration-300">
								<img
									src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80"
									alt="Bibliothèque"
									width="400"
									height="533"
									loading="lazy"
									class="w-full h-full object-cover"
								>
							</div>
						</div>
						<div class="space-y-4 pt-8">
							<div class="aspect-[3/4] rounded-lg overflow-hidden shadow-2xl transform -rotate-3 hover:rotate-0 transition-transform duration-300">
								<img
									src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=400&q=80"
									alt="Lecture"
									width="400"
									height="533"
									loading="lazy"
									class="w-full h-full object-cover"
								>
							</div>
							<div class="aspect-[3/4] rounded-lg overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-300">
								<img
									src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400&q=80"
									alt="Livres empilés"
									width="400"
									height="533"
									loading="lazy"
									class="w-full h-full object-cover"
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	{# 1. Meilleures ventes + Categories - Combined section with same background #}
	<section
		id="categories" class="pt-8 md:pt-12 pb-16 relative overflow-hidden">
		{# Layered background: image + gradient (same style as header) #}
		<div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30" style="background-image: url('https://picsum.photos/1200/800');"></div>
		<div class="absolute inset-0 bg-linear-to-br from-white/100 via-contrasted-100/85 to-white/100"></div>
		{# Decorative elements similar to subscription #}
		<div class="absolute inset-0 opacity-5">
			<div class="absolute top-0 left-0 w-96 h-96 bg-primary-300 rounded-full blur-3xl"></div>
			<div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-200 rounded-full blur-3xl"></div>
		</div>

		<div
			class="container mx-auto px-4 relative z-10">
			{# Bestsellers Section #}
			<div class="text-center mb-6">
				<h2 class="font-bodoni text-2xl md:text-3xl font-bold text-primary-900 mb-2 relative inline-block">
					<span class="relative z-10">Meilleures ventes</span>
					<span class="absolute bottom-0 left-0 right-0 h-2 bg-secondary-500/30 -z-0 transform -skew-x-12"></span>
				</h2>
			</div>

			<div class="flex flex-wrap gap-4 md:gap-12 justify-center items-start mb-16">
				{% if bestsellers is defined and bestsellers|length > 0 %}
					{% for book in bestsellers|slice(0, 6) %}
						{% include 'components/minimal_book_card.html.twig' with {
                        title: book.title,
                        author: book.author,
                        imageUrl: book.cover_url|default('https://picsum.photos/200/300?random=' ~ loop.index),
                        bookUrl: book.work_id is defined ? path('app_work_show', { id: book.work_id }) : null
                    } %}
					{% endfor %}
				{% else %}
					{% for i in 1..6 %}
						{% include 'components/minimal_book_card.html.twig' with {
                        title: 'Le Nom du Vent',
                        author: 'Patrick Rothfuss',
                        imageUrl: 'https://picsum.photos/200/300?random=' ~ i
                    } %}
					{% endfor %}
				{% endif %}
			</div>

			{# Categories Section #}
			{% if categories is defined and categories|length > 0 %}
				{% include 'components/section_header.html.twig' with {
                title: null,
                subtitle: null,
                centered: true,
                showViewAll: false
            } %}

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8">
					{% for category in categories|slice(0, 3) %}
						<div class="bg-primary-100 rounded-lg p-6 shadow-md hover:shadow-xl transition-all duration-300">
							<h3 class="font-bodoni text-xl font-bold text-primary-900 mb-2">
								{{ category.name }}
							</h3>
							<p class="font-bodoni text-sm text-primary-600 mb-4">
								{{ category.work_count }}
								livres disponibles
							</p>

							{% if category.books is defined and category.books|length > 0 %}
								<div class="flex flex-wrap gap-4 justify-center">
									{% for book in category.books|slice(0, 4) %}
										{% include 'components/work_card.html.twig' with {
                                        work: book
                                    } %}
									{% endfor %}
								</div>
							{% else %}
								<div class="flex flex-wrap gap-4 justify-center">
									{% for i in 1..4 %}
										{# No placeholder cards - only show real data #}
									{% endfor %}
								</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</section>

	{# 3. Monthly Box / Subscription Highlight #}
	{% include 'components/subscription_box.html.twig' with { ctaUrl: path('app_subscription_index'), ctaText: "Voir les offres et s'abonner" } %}

	{# 4. Sélection des libraires #}
	<section class="bg-primary-100 py-16">
		<div class="container mx-auto px-4">
			{% include 'components/section_header.html.twig' with {
            title: 'Nos coups de cœur',
            subtitle: 'Des livres qui nous ont marqués, sélectionnés avec soin par notre équipe de passionnés',
            centered: true,
            badge: 'Sélection des libraires',
            showViewAll: false
        } %}

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 w-fit mx-auto">
				{% if editorsPicks is defined and editorsPicks|length > 0 %}
					{% for book in editorsPicks %}
						{% include 'components/work_card.html.twig' with {
                        work: book,
                        showHeartIcon: true,
                        hoverQuote: null,
                        buttonText: 'Voir',
                        buttonClass: 'bg-primary-500 hover:bg-primary-600'
                    } %}
					{% endfor %}
				{% else %}
					{% for i in 1..4 %}
						{# No placeholder cards - only show real data #}
					{% endfor %}
				{% endif %}
			</div>
		</div>
	</section>

	{# 5. Newsletter Signup Section #}
	{% include 'components/newsletter_signup.html.twig' %}
{% endblock %}

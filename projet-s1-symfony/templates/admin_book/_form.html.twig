{{ form_start(form) }}
<table class="min-w-full">
	<tbody class="divide-y divide-primary-100">
		{% for child in form.children %}
			{% if child.vars.name != '_token' %}
				<tr class="hover:bg-primary-50 transition-colors duration-200">
					<th class="px-6 py-4 bg-primary-100 text-left text-sm font-bold text-primary-900 uppercase tracking-wider w-1/3 align-top">
						{{ form_label(child) }}
					</th>
					<td class="px-6 py-4">
						{{ form_widget(child, {'attr': {'class': 'w-full px-4 py-2 border border-primary-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors'}}) }}
						{{ form_errors(child) }}
					</td>
				</tr>
			{% endif %}
		{% endfor %}
		<tr>
			<td colspan="2" class="px-6 py-6 text-right bg-white">
				<button type="submit" class="inline-flex items-center gap-2 bg-contrasted-900 text-white rounded-lg px-8 py-3 shadow-sm hover:shadow-md hover:bg-contrasted-800 transition-all duration-300">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
					</svg>
					<span class="font-bodoni font-medium">{{ button_label|default('Enregistrer') }}</span>
				</button>
			</td>
		</tr>
	</tbody>
</table>
{{ form_end(form) }}

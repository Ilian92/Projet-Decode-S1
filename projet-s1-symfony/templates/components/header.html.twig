<header class="bg-primary-500 shadow-lg">
    <div class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between gap-8">
            {# Logo / Nom du site #}
            <div class="flex-shrink-0">
                <a href="{{ path('app_home') }}" class="text-2xl font-bold text-white hover:text-primary-200 transition-colors">
                    mississipi
                </a>
            </div>

            {# Barre de recherche #}
            <div class="flex-grow max-w-2xl">
                <form action="#" method="get" class="relative">
                    <input 
                        type="search" 
                        name="q" 
                        placeholder="Rechercher un livre, un auteur..." 
                        class="w-full px-4 py-2 pr-10 rounded-lg border-2 border-primary-500 focus:border-primary-300 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-500 placeholder:text-primary-500"
                    >
                    <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-primary-700 hover:text-primary-900">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </button>
                </form>
            </div>

            {# Icône utilisateur #}
            <div class="flex-shrink-0">
                <a href="{{ path('app_login') }}" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-primary-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</header>
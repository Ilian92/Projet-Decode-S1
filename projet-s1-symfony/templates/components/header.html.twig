<header class="group/header w-full fixed top-0 left-0 right-0 z-50 bg-primary-600">
	<div class="shadow-lg w-full group-hover/header:py-6 px-4 py-2 transition-all duration-300">
		<div class="container m-auto flex flex-col gap-0 group-hover/header:gap-2 relative z-20">
			<div
				class="flex items-center justify-around gap-8 relative z-20">
				{# Logo / Nom du site #}
				<div class="shrink-0">
					<a href="{{ path('app_home') }}" class="font-puppies font-bold group/logo transition-colors">
						<text class="text-6xl text-primary-200 group-hover/logo:text-primary-400">Mississippi</text>
						<text class="text-3xl text-secondary-950 group-hover/logo:text-secondary-900">.com</text>
					</a>
				</div>

				{# Barre de recherche #}
				<div class="grow max-w-2xl">
					<form action="{{ path('app_search') }}" method="get" class="relative">
						<input type="search" name="q" placeholder="Rechercher un livre, un auteur..." class="font-bodoni w-full px-4 py-2 pr-10 rounded-md focus:border-primary-300 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-500 placeholder:text-primary-500" value="{{ app.request.query.get('q', '') }}">
						<button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-primary-700 hover:text-primary-900">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
							</svg>
						</button>
					</form>
				</div>

				{# User section: Cart, Name, Disconnect (if logged in) or Login icon (if not) #}
				<div class="flex-shrink-0 flex items-center gap-3 relative z-[100]" id="header-user-section" style="z-index: 100;">
					{% if app.user %}
						{# Shopping Cart #}
						<a href="{{ path('cart_show') }}" id="header-cart-btn" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-primary-100 transition-colors relative z-[100] pointer-events-auto" style="z-index: 100; pointer-events: auto;" aria-label="Panier ({{ cart_item_count }} article{{ cart_item_count != 1 ? 's' : '' }})">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-700" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
							</svg>
							{% if cart_item_count > 0 %}
								<span class="absolute -top-1 -right-1 bg-secondary-800 text-white text-xs font-bold rounded-full min-w-5 h-5 flex items-center justify-center px-1">{{ cart_item_count }}</span>
							{% endif %}
						</a>

						{# User Name #}
						<div id="header-user-name" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white/80 hover:bg-white transition-colors relative z-[100] pointer-events-auto" style="z-index: 100; pointer-events: auto;">
							<span class="font-bodoni text-primary-700 text-sm font-medium">
								{{ app.user.firstName }}
								{{ app.user.lastName }}
							</span>
						</div>

						{# Disconnect Button #}
						<a href="{{ path('app_logout') }}" id="header-logout-btn" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-red-100 transition-colors relative z-[100] pointer-events-auto" style="z-index: 100; pointer-events: auto;" aria-label="Déconnexion" title="Déconnexion">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-700 hover:text-red-700 transition-colors" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
							</svg>
						</a>
					{% else %}
						{# Shopping Cart (when not logged in) #}
						<a href="{{ path('cart_show') }}" id="header-cart-btn-guest" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-primary-100 transition-colors relative z-[100] pointer-events-auto" style="z-index: 100; pointer-events: auto;" aria-label="Panier ({{ cart_item_count }} article{{ cart_item_count != 1 ? 's' : '' }})">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-700" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
							</svg>
							{% if cart_item_count > 0 %}
								<span class="absolute -top-1 -right-1 bg-secondary-800 text-white text-xs font-bold rounded-full min-w-5 h-5 flex items-center justify-center px-1">{{ cart_item_count }}</span>
							{% endif %}
						</a>

						{# Login Icon (when not logged in) #}
						<a href="{{ path('app_login') }}" id="header-login-btn" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-primary-100 transition-colors relative z-[100] pointer-events-auto" style="z-index: 100; pointer-events: auto;" aria-label="Connexion">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-700" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</a>
					{% endif %}
				</div>
			</div>
			{# Description du site (visible au survol) #}
			<p class="font-bodoni text-primary-200 text-sm text-center max-h-0 opacity-0 overflow-hidden group-hover/header:max-h-16 group-hover/header:opacity-100 transition-all duration-300">
				Votre librairie en ligne — Livres neufs et d'occasion, ebooks et sélections curatées pour tous les lecteurs.
			</p>
		</div>
	</div>
	<div class="bg-contrasted-600 w-full h-2 group-hover/header:h-1 transition-all duration-300 shadow-lg relative z-[50]"></div>
	<nav class="relative w-full h-0 shadow-lg group-hover/header:h-20 transition-all duration-300 absolute overflow-hidden z-[50] pointer-events-none group-hover/header:pointer-events-auto" style="z-index: 50; top: 100%;">
		<div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-40" style="background-image: url('https://picsum.photos/1200/200');"></div>
		<div class="absolute inset-0 bg-contrasted-100/80"></div>
		<div
			class="container relative z-10 mx-auto px-4 h-full flex items-center justify-center gap-8 pointer-events-auto">
			{# Catégories principales #}
			<div class="flex items-center gap-6">
				{% for key, label in subject_filters %}
					<a href="{{ path('app_search', { subject: key }) }}" class="font-bodoni text-contrasted-400 hover:text-contrasted-600 font-medium hover:text-2xl transition-all duration-200 whitespace-nowrap">{{ label }}</a>
				{% endfor %}
			</div>

			{# Séparateur #}
			<div class="h-8 w-px bg-contrasted-400"></div>

			{# Liens utilitaires #}
			<div class="flex items-center gap-6">
				<a href="#" class="font-bodoni text-primary-500 hover:text-primary-700 hover:text-2xl font-medium transition-all duration-200 whitespace-nowrap">Livres d'occasion</a>
				<a href="#" class="font-bodoni text-primary-500 hover:text-primary-700 hover:text-2xl font-medium transition-all duration-200 whitespace-nowrap">Ebooks</a>
				<a href="#" class="font-bodoni text-primary-500 hover:text-primary-700 hover:text-2xl font-medium transition-all duration-200 whitespace-nowrap">Sélections</a>
			</div>
		</div>
	</nav>
	<script>
		(function () {
			if (window.headerClickHandlerAttached) return;
			window.headerClickHandlerAttached = true;

			if (!window.headerClickHandler) {
				window.headerClickHandler = function (e) {
					const path = e.composedPath();
					const cartBtn = document.getElementById('header-cart-btn');
					const logoutBtn = document.getElementById('header-logout-btn');
					const loginBtn = document.getElementById('header-login-btn');

					let clickedButton = null;
					for (let i = 0; i < path.length; i++) {
						const element = path[i];
						if (element === cartBtn) {
							clickedButton = { type: 'cart', element: cartBtn };
							break;
						}
						if (element === logoutBtn) {
							clickedButton = { type: 'logout', element: logoutBtn };
							break;
						}
						if (element === loginBtn) {
							clickedButton = { type: 'login', element: loginBtn };
							break;
						}
					}

					if (clickedButton && clickedButton.type !== 'cart' && e.defaultPrevented) {
						window.location.href = clickedButton.element.href;
					}
				};
			}

			document.addEventListener('click', window.headerClickHandler, false);
		})();
	</script>

</header>

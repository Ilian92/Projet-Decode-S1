<header class="group/header w-full fixed top-0 left-0 right-0 z-50 bg-primary-600">
	<div class="shadow-lg w-full group-hover/header:py-6 px-4 py-2 transition-all duration-300">
		<div class="container m-auto flex flex-col gap-0 group-hover/header:gap-2">
			<div
				class="flex items-center justify-around gap-8">
				{# Logo / Nom du site #}
				<div class="shrink-0">
					<a href="{{ path('app_home') }}" class="font-puppies font-bold group/logo transition-colors">
						<text class="text-6xl text-primary-200 group-hover/logo:text-primary-400">Mississipi</text>
						<text class="text-3xl text-secondary-950 group-hover/logo:text-secondary-900">.com</text>
					</a>
				</div>

				{# Barre de recherche #}
				<div class="grow max-w-2xl">
					<form action="{{ path('app_search') }}" method="get" class="relative">
						<input type="search" name="q" placeholder="Rechercher un livre, un auteur..." class="font-bodoni w-full px-4 py-2 pr-10 rounded-md focus:border-primary-300 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-500 placeholder:text-primary-500" value="{{ app.request.query.get('q', '') }}">
						<button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-primary-700 hover:text-primary-900">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
							</svg>
						</button>
					</form>
				</div>

				{# Icône utilisateur #}
				<div class="flex-shrink-0">
					<a href="{{ path('app_login') }}" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-primary-100 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-700" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
						</svg>
					</a>
				</div>
			</div>
			{# Description du site (visible au survol) #}
			<p class="font-bodoni text-primary-200 text-sm text-center max-h-0 opacity-0 overflow-hidden group-hover/header:max-h-16 group-hover/header:opacity-100 transition-all duration-300">
				Votre librairie en ligne — Livres neufs et d'occasion, ebooks et sélections curatées pour tous les lecteurs.
			</p>
		</div>
	</div>
	<div class="bg-contrasted-600 w-full h-0.5 shadow-lg"></div>
	<nav class="relative w-full h-0 shadow-lg group-hover/header:h-20 transition-all duration-300 absolute overflow-hidden">
		<div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-40" style="background-image: url('https://picsum.photos/1200/200');"></div>
		<div class="absolute inset-0 bg-contrasted-100/80"></div>
		<div
			class="container relative z-10 mx-auto px-4 h-full flex items-center justify-center gap-8">
			{# Catégories principales #}
			<div class="flex items-center gap-6">
				<a href="#" class="font-bodoni text-contrasted-400 hover:text-contrasted-600 font-medium hover:text-2xl transition-all duration-200 whitespace-nowrap">Littérature</a>
				<a href="#" class="font-bodoni text-contrasted-400 hover:text-contrasted-600 font-medium hover:text-2xl transition-all duration-200 whitespace-nowrap">BD/Mangas</a>
				<a href="#" class="font-bodoni text-contrasted-400 hover:text-contrasted-600 font-medium hover:text-2xl transition-all duration-200 whitespace-nowrap">Jeunesse</a>
				<a href="#" class="font-bodoni text-contrasted-400 hover:text-contrasted-600 font-medium hover:text-2xl transition-all duration-200 whitespace-nowrap">Policier</a>
				<a href="#" class="font-bodoni text-contrasted-400 hover:text-contrasted-600 font-medium hover:text-2xl transition-all duration-200 whitespace-nowrap">Science-Fiction</a>
			</div>

			{# Séparateur #}
			<div class="h-8 w-px bg-contrasted-400"></div>

			{# Liens utilitaires #}
			<div class="flex items-center gap-6">
				<a href="#" class="font-bodoni text-primary-500 hover:text-primary-700 hover:text-2xl font-medium transition-all duration-200 whitespace-nowrap">Livres d'occasion</a>
				<a href="#" class="font-bodoni text-primary-500 hover:text-primary-700 hover:text-2xl font-medium transition-all duration-200 whitespace-nowrap">Ebooks</a>
				<a href="#" class="font-bodoni text-primary-500 hover:text-primary-700 hover:text-2xl font-medium transition-all duration-200 whitespace-nowrap">Sélections</a>
			</div>
		</div>
	</nav>

</header>

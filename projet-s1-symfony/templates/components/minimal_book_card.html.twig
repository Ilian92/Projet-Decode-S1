{# Minimal Book Card Component - Small card for featured books

   Parameters:
   - title: Book title (required)
   - author: Author name (required)
   - imageUrl: Cover image URL (default: placeholder)
   - bookUrl: Optional URL - when set, the whole card is clickable (e.g. search or work page)
#}
<article class="group cursor-pointer transform hover:scale-105 transition-all duration-300">
	{% if bookUrl is defined and bookUrl %}
		<a href="{{ bookUrl }}" class="block w-24" aria-label="Voir {{ title }}">
	{% endif %}
	<div class="w-24 h-32 md:w-28 md:h-36 bg-primary-100 rounded shadow-2xl hover:shadow-4xl transition-shadow duration-300 overflow-hidden ring-2 ring-transparent hover:ring-secondary-500/40 transition-all">
		<img
			src="{{ imageUrl|default('https://picsum.photos/200/300?random=' ~ random(1000)) }}"
			alt="Couverture de {{ title }}"
			width="200"
			height="300"
			loading="lazy"
			class="w-full h-full object-cover"
		>
	</div>
	<div class="mt-2 text-center">
		<h3 class="font-bodoni text-xs font-bold text-primary-900 line-clamp-2 mb-0.5 group-hover:text-secondary-700 transition-colors">
			{{ title }}
		</h3>
		<p class="font-bodoni text-xs text-primary-600 line-clamp-1">
			{{ author }}
		</p>
	</div>
	{% if bookUrl is defined and bookUrl %}
		</a>
	{% endif %}
</article>

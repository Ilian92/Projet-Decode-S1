{# Book Card Component
   
   Parameters:
   - book: Book entity (optional, for dynamic data)
   - title: Book title (default: "Le Nom du Vent")
   - author: Author name (default: "Patrick Rothfuss")
   - price: Price in euros (default: "24,90")
   - imageUrl: Cover image URL (default: placeholder)
   - rating: Rating value (default: 4.8)
   - badge: Badge text (optional, e.g. "Bestseller", "Nouveau")
   - badgeColor: Badge color class (default: "bg-secondary-800")
   - showRating: Show rating stars (default: true)
   - buttonText: Button text (default: "Ajouter")
   - buttonClass: Button style class (default: "bg-secondary-800 hover:bg-secondary-900")
   - hoverQuote: Quote to show on hover (optional)
   - showHeartIcon: Show heart icon for favorites (default: false)
#}

<article class="bg-white rounded-lg shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group cursor-pointer w-40">
	<div class="aspect-3/4 bg-primary-100 overflow-hidden relative">
		<img src="{{ imageUrl|default('https://picsum.photos/300/400?random=' ~ random(1000)) }}" alt="Couverture de {{ title|default('Le Nom du Vent') }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
		{% if badge is defined and badge %}
			<div class="absolute top-1.5 right-1.5">
				<span class="inline-block {{ badgeColor|default('bg-secondary-800') }} text-white font-bodoni text-xs font-bold px-1.5 py-0.5 rounded">
					{{ badge }}
				</span>
			</div>
		{% endif %}
		{% if hoverQuote is defined and hoverQuote %}
			<div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-3">
				<p class="font-bodoni text-white text-xs line-clamp-2">
					"{{ hoverQuote }}"
				</p>
			</div>
		{% endif %}
	</div>
	<div class="p-3">
		{% if showHeartIcon|default(false) %}
			<div class="flex items-center gap-1.5 mb-1.5">
				<svg class="w-4 h-4 text-secondary-800" fill="currentColor" viewbox="0 0 20 20">
					<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
				</svg>
				<span class="font-bodoni text-xs text-primary-600 font-medium">Coup de cœur</span>
			</div>
		{% endif %}
		<h3 class="font-bodoni text-sm font-bold text-primary-900 mb-1 line-clamp-2">
			{{ title|default('Le Nom du Vent') }}
		</h3>
		<p class="font-bodoni text-xs text-primary-600 mb-1.5">
			{{ author|default('Patrick Rothfuss') }}
		</p>
		{% if showRating|default(true) %}
			<div class="flex items-center gap-0.5 mb-2">
				{% set ratingValue = rating|default(4.8) %}
				{% for star in 1..5 %}
					<svg class="w-3.5 h-3.5 text-yellow-400 fill-current" viewbox="0 0 20 20">
						<path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
					</svg>
				{% endfor %}
				<span class="font-bodoni text-xs text-primary-600 ml-1">({{ ratingValue }})</span>
			</div>
		{% endif %}
		<div class="flex items-center justify-between gap-2">
			<span class="font-bodoni text-base font-bold text-secondary-800">
				{{ price|default('24,90') }}
				€
			</span>
			<button class="{{ buttonClass|default('bg-secondary-800 hover:bg-secondary-900') }} text-white px-3 py-1.5 rounded-md text-xs font-bodoni font-medium transition-colors duration-200 whitespace-nowrap">
				{{ buttonText|default('Ajouter') }}
			</button>
		</div>
	</div>
</article>

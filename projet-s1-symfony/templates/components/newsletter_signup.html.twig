{# Newsletter Signup Component
   
   Parameters:
   - title: Heading text (default: "Restez informé")
   - description: Description text (optional)
   - formAction: Form action URL (default: "#")
   - formMethod: Form method (default: "post")
   - buttonText: Submit button text (default: "S'abonner")
   - showPrivacyNote: Show privacy note (default: true)
#}

<section class="bg-white py-16 border-t border-primary-200">
    <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl p-12 shadow-lg">
            <div class="w-20 h-20 mx-auto mb-6 bg-secondary-800 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            <h2 class="font-bodoni text-3xl md:text-4xl font-bold text-primary-900 mb-4">
                {{ title|default('Restez informé') }}
            </h2>
            {% if description is defined and description %}
            <p class="font-bodoni text-lg text-primary-700 mb-8 leading-relaxed">
                {{ description }}
            </p>
            {% else %}
            <p class="font-bodoni text-lg text-primary-700 mb-8 leading-relaxed">
                Recevez nos dernières nouveautés, promotions exclusives et conseils de lecture directement dans votre boîte mail.
            </p>
            {% endif %}
            <form action="{{ formAction|default('#') }}" method="{{ formMethod|default('post') }}" class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
                <input 
                    type="email" 
                    name="email" 
                    placeholder="Votre adresse email" 
                    required
                    class="font-bodoni flex-1 px-6 py-3 rounded-md border-2 border-primary-300 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-300 bg-white text-primary-700 placeholder:text-primary-400"
                >
                <button 
                    type="submit"
                    class="bg-secondary-800 hover:bg-secondary-900 text-white font-bodoni font-medium px-8 py-3 rounded-md transition-colors duration-200 shadow-md hover:shadow-lg whitespace-nowrap"
                >
                    {{ buttonText|default("S'abonner") }}
                </button>
            </form>
            {% if showPrivacyNote|default(true) %}
            <p class="font-bodoni text-xs text-primary-600 mt-4">
                En vous abonnant, vous acceptez de recevoir nos emails. Vous pouvez vous désabonner à tout moment.
            </p>
            {% endif %}
        </div>
    </div>
</section>

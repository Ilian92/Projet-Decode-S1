{# New Release Card Component
   
   Parameters:
   - title: Book title (default: "L'Art de la Guerre")
   - author: Author name (default: "Sun Tzu")
   - description: Book description (optional)
   - price: Price in euros (default: "19,90")
   - imageUrl: Cover image URL (default: placeholder)
   - releaseDate: Release date text (default: "Janvier 2026")
   - buttonText: Button text (default: "Découvrir")
#}

<article class="bg-primary-50 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 group">
    <div class="md:flex">
        <div class="md:w-1/3 aspect-[3/4] md:aspect-auto bg-primary-100 overflow-hidden">
            <img 
                src="{{ imageUrl|default('https://picsum.photos/400/600?random=' ~ random(1000)) }}" 
                alt="Couverture de {{ title|default('L\'Art de la Guerre') }}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            >
        </div>
        <div class="md:w-2/3 p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block bg-contrasted-500 text-white font-bodoni text-xs font-bold px-2 py-1 rounded">
                        Nouveau
                    </span>
                    <span class="font-bodoni text-xs text-primary-600">
                        {{ releaseDate|default('Janvier 2026') }}
                    </span>
                </div>
                <h3 class="font-bodoni text-xl font-bold text-primary-900 mb-2">
                    {{ title|default('L\'Art de la Guerre') }}
                </h3>
                <p class="font-bodoni text-sm text-primary-600 mb-3">
                    {{ author|default('Sun Tzu') }}
                </p>
                {% if description is defined and description %}
                <p class="font-bodoni text-sm text-primary-700 mb-4 line-clamp-3 leading-relaxed">
                    {{ description }}
                </p>
                {% else %}
                <p class="font-bodoni text-sm text-primary-700 mb-4 line-clamp-3 leading-relaxed">
                    Un classique intemporel de stratégie militaire qui continue d'inspirer les leaders modernes dans tous les domaines.
                </p>
                {% endif %}
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-primary-200">
                <span class="font-bodoni text-xl font-bold text-secondary-800">
                    {{ price|default('19,90') }} €
                </span>
                <button class="bg-secondary-800 hover:bg-secondary-900 text-white px-6 py-2 rounded-md font-bodoni font-medium transition-colors duration-200">
                    {{ buttonText|default('Découvrir') }}
                </button>
            </div>
        </div>
    </div>
</article>

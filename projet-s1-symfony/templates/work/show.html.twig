{% extends 'base.html.twig' %}

{% block title %}
	{{ work.title }}
	- Mississippi.com
{% endblock %}

{% block body %}
	<div class="bg-white min-h-screen">
		<div
			class="container mx-auto px-4 py-6">
			{# Breadcrumb (Amazon-style) #}
			<nav class="font-bodoni text-sm text-primary-600 mb-4" aria-label="Fil d'Ariane">
				<ol class="flex flex-wrap items-center gap-1">
					<li>
						<a href="{{ path('app_home') }}" class="hover:text-secondary-800 underline">Accueil</a>
					</li>
					<li aria-hidden="true">›</li>
					<li>
						<a href="{{ path('app_search') }}" class="hover:text-secondary-800 underline">Recherche</a>
					</li>
					<li aria-hidden="true">›</li>
					<li class="text-primary-900 font-medium line-clamp-1">{{ work.title }}</li>
				</ol>
			</nav>

			{# Product layout: cover left, details right (Amazon-style) #}
			<div
				class="flex flex-col lg:flex-row gap-8 lg:gap-12 mb-12">
				{# Cover - left column #}
				<div class="lg:w-80 shrink-0 flex justify-center lg:justify-start">
					<div class="w-56 sm:w-64 lg:w-80 aspect-[3/4] bg-primary-100 rounded-lg shadow-lg overflow-hidden">
						{% if work.cover_url %}
							<img src="{{ work.cover_url }}" alt="Couverture de {{ work.title }}" class="w-full h-full object-cover">
						{% else %}
							<div class="w-full h-full flex items-center justify-center text-primary-400 font-bodoni text-sm">Pas de couverture</div>
						{% endif %}
					</div>
				</div>

				{# Details - right column #}
				<div class="flex-1 min-w-0">
					<h1 class="font-sancreek text-2xl md:text-3xl lg:text-4xl font-bold text-primary-900 mb-2">
						{{ work.title }}
					</h1>
					<p class="font-bodoni text-primary-600 mb-4">
						par
						{% for author in work.authors %}
							<span class="text-primary-800 font-medium">{{ author.name }}</span>
							{% if not loop.last %},
							{% endif %}
						{% endfor %}
					</p>

					{% if work.first_publish_year %}
						<p class="font-bodoni text-sm text-primary-600 mb-2">
							Première publication :
							{{ work.first_publish_year }}
						</p>
					{% endif %}

					{# Ratings #}
					{% if work.ratings and work.ratings.average %}
						<div class="mb-4">
							{% include 'components/rating_stars.html.twig' with {
								rating: work.ratings.average,
								count: work.ratings.count,
								size: 'w-5 h-5'
							} %}
							{% if work.ratings.count > 0 %}
								<p class="font-bodoni text-sm text-primary-600 mt-1">
									{{ work.ratings.count }}
									avis
								</p>
							{% endif %}
						</div>
					{% endif %}

					{# Note: Price and purchase options are shown per edition below #}

					{# Description #}
					{% if work.description %}
						<div class="border-t border-primary-200 pt-6 mt-6">
							<h2 class="font-sancreek text-lg font-bold text-primary-900 mb-3">Présentation</h2>
							<div class="font-bodoni text-primary-700 text-sm leading-relaxed prose prose-primary max-w-none">
								{{ work.description|nl2br }}
							</div>
						</div>
					{% endif %}
				</div>
			</div>

			{# Editions Section #}
			<section class="border-t border-primary-200 pt-8 mb-12" aria-labelledby="editions-heading">
				<h2 id="editions-heading" class="font-sancreek text-xl font-bold text-primary-900 mb-6">
					Éditions disponibles
					{% if editions|length > 0 %}
						({{ editions|length }})
					{% endif %}
				</h2>
				{% if editions|length > 0 %}
					<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
						{% for edition in editions %}
							{% include 'components/edition_card.html.twig' with { edition: edition } %}
						{% endfor %}
					</div>
				{% else %}
					<div class="text-center py-8">
						<p class="font-bodoni text-primary-700 mb-2">Aucune édition disponible pour l'instant.</p>
						<p class="font-bodoni text-sm text-primary-600">Les éditions de cette œuvre seront bientôt disponibles à la commande.</p>
					</div>
				{% endif %}
			</section>

			{# Product details (subjects) - Amazon "Product details" style #}
			{% if work.subjects|length > 0 %}
				<section class="border-t border-primary-200 pt-8 mb-12" aria-labelledby="product-details-heading">
					<h2 id="product-details-heading" class="font-sancreek text-xl font-bold text-primary-900 mb-4">Détails du livre</h2>
					<dl class="font-bodoni text-sm grid grid-cols-1 sm:grid-cols-2 gap-2">
						<dt class="text-primary-600 font-medium">Genres / Sujets</dt>
						<dd class="text-primary-800">
							{% for subject in work.subjects %}
								<a href="{{ path('app_search', { q: subject }) }}" class="hover:text-secondary-800 underline">{{ subject }}</a>
								{% if not loop.last %},
								{% endif %}
							{% endfor %}
						</dd>
					</dl>
				</section>
			{% endif %}

		</div>
	</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes{% endblock %}

{% block body %}
    <section class="py-8 md:py-12 bg-primary-50">
        <div class="container mx-auto px-4">
            <div class="mb-8 flex justify-between items-center">
                <h1 class="font-bodoni text-3xl md:text-4xl font-bold text-primary-900">
                    <span class="relative inline-block">
                        <span class="relative z-10">Gestion des commandes</span>
                        <span class="absolute bottom-0 left-0 right-0 h-2 bg-secondary-500/30 -z-0 transform -skew-x-12"></span>
                    </span>
                </h1>
                <a href="{{ path('app_admin_order_new') }}" class="inline-flex items-center gap-2 bg-secondary-800 border-2 border-primary-50 hover:border-secondary-500 rounded-lg px-6 py-3 shadow-sm hover:shadow-md transition-all duration-300 group">
                    <svg class="w-5 h-5 text-primary-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span class="font-bodoni text-primary-100 group-hover:text-white font-medium">Nouvelle commande</span>
                </a>
            </div>

            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <table class="w-full table-fixed divide-y divide-primary-200">
                    <thead class="bg-primary-100">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold text-primary-900 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-primary-900 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-primary-900 uppercase tracking-wider">Statut</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-primary-900 uppercase tracking-wider">Montant total</th>
                            <th class="px-6 py-4 text-center text-xs font-bold text-primary-900 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-primary-100">
                    {% for order in orders %}
                        <tr class="hover:bg-primary-50 transition-colors duration-200">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-primary-900">{{ order.id }}</td>
                            <td class="px-6 py-4 text-sm text-primary-800 font-semibold">{{ order.orderDate ? order.orderDate|date('d/m/Y H:i') : '' }}</td>
                            <td class="px-6 py-4 text-sm text-primary-600">{{ order.status }}</td>
                            <td class="px-6 py-4 text-sm text-primary-600">{{ order.totalAmount }} €</td>
                            <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                <div class="flex justify-center gap-2">
                                    <a href="{{ path('app_admin_order_show', {'id': order.id}) }}" class="inline-flex items-center px-3 py-1.5 bg-primary-500 text-white rounded hover:bg-primary-600 transition-colors duration-200">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        Voir
                                    </a>
                                    <a href="{{ path('app_admin_order_edit', {'id': order.id}) }}" class="inline-flex items-center px-3 py-1.5 bg-contrasted-900 text-white rounded hover:bg-contrasted-800 transition-colors duration-200">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-primary-600 font-bodoni text-lg">
                                <svg class="w-16 h-16 mx-auto mb-4 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                Aucune commande trouvée
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endblock %}

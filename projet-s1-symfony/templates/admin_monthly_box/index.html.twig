{% extends 'base.html.twig' %}

{% block title %}MonthlyBox index{% endblock %}

{% block body %}
    <h1>MonthlyBox index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>ReferenceMonth</th>
                <th>CreationDate</th>
                <th>ShippingStatus</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for monthly_box in monthly_boxes %}
            <tr>
                <td>{{ monthly_box.id }}</td>
                <td>{{ monthly_box.referenceMonth }}</td>
                <td>{{ monthly_box.creationDate ? monthly_box.creationDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ monthly_box.shippingStatus }}</td>
                <td>
                    <a href="{{ path('app_admin_monthly_box_show', {'id': monthly_box.id}) }}">show</a>
                    <a href="{{ path('app_admin_monthly_box_edit', {'id': monthly_box.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_monthly_box_new') }}">Create new</a>
{% endblock %}

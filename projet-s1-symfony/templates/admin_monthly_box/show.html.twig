{% extends 'base.html.twig' %}

{% block title %}MonthlyBox{% endblock %}

{% block body %}
    <h1>MonthlyBox</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ monthly_box.id }}</td>
            </tr>
            <tr>
                <th>ReferenceMonth</th>
                <td>{{ monthly_box.referenceMonth }}</td>
            </tr>
            <tr>
                <th>CreationDate</th>
                <td>{{ monthly_box.creationDate ? monthly_box.creationDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ShippingStatus</th>
                <td>{{ monthly_box.shippingStatus }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_monthly_box_index') }}">back to list</a>

    <a href="{{ path('app_admin_monthly_box_edit', {'id': monthly_box.id}) }}">edit</a>

    {{ include('admin_monthly_box/_delete_form.html.twig') }}
{% endblock %}
